<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Active Connected WebView Container -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_dark" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Connection Setup Stage (Constrained to max 460dp on Tablets, Full Width on Phones) -->
    <LinearLayout
        android:id="@+id/connectionLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintWidth_max="460dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="14dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="ADrop"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/connect_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Status notice (e.g. when last auto-connect failed) -->
        <TextView
            android:id="@+id/tvStatusNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pill_reconnect_card"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/accent_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Setup Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Scan QR Pill Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/pill_button_accent"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/scan_qr_btn"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="— OR CONNECT VIA IP —"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etIpAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/pill_input_field"
                android:fontFamily="monospace"
                android:hint="@string/manual_ip_hint"
                android:inputType="textUri"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnManualConnect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/pill_button_outlined"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/connect_btn"
                android:textAllCaps="false"
                android:textColor="@color/accent_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Reconnect Last PC Pill -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReconnectLast"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/pill_reconnect_card"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            android:text="@string/reconnect_btn"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
